--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -59,6 +59,106 @@
 // and we'll use C++ attribute syntax.
 #define GGML_CACHE_LINE  64
 
+struct ggml_cpu_profile_record {
+    uint64_t graph_id;
+    int node_index;
+    int op;
+    int fused_nodes;
+    int64_t worker_us;
+    int64_t barrier_us;
+    int64_t graph_elapsed_us;
+    const char * name;
+    const char * src0;
+    const char * src1;
+};
+
+static volatile int ggml_cpu_profile_active = 0;
+static uint64_t ggml_cpu_profile_graph_counter = 0;
+static struct ggml_cpu_profile_record * ggml_cpu_profile_records = NULL;
+static size_t ggml_cpu_profile_count = 0;
+static size_t ggml_cpu_profile_capacity = 0;
+static char ggml_cpu_profile_path[1024] = {0};
+
+bool ggml_cpu_profile_begin(const char * output_csv) {
+    if (output_csv == NULL || output_csv[0] == '\0' || ggml_cpu_profile_active) {
+        return false;
+    }
+    ggml_cpu_profile_capacity = 262144;
+    ggml_cpu_profile_records = (struct ggml_cpu_profile_record *) calloc(
+        ggml_cpu_profile_capacity, sizeof(struct ggml_cpu_profile_record));
+    if (ggml_cpu_profile_records == NULL) {
+        ggml_cpu_profile_capacity = 0;
+        return false;
+    }
+    snprintf(ggml_cpu_profile_path, sizeof(ggml_cpu_profile_path), "%s", output_csv);
+    ggml_cpu_profile_count = 0;
+    ggml_cpu_profile_graph_counter = 0;
+    ggml_cpu_profile_active = 1;
+    return true;
+}
+
+void ggml_cpu_profile_end(void) {
+    if (!ggml_cpu_profile_active) {
+        return;
+    }
+    ggml_cpu_profile_active = 0;
+    FILE * file = fopen(ggml_cpu_profile_path, "wb");
+    if (file != NULL) {
+        fprintf(file, "graph_id,node_index,op,fused_nodes,worker_us,barrier_us,graph_elapsed_us,name,src0,src1\n");
+        for (size_t i = 0; i < ggml_cpu_profile_count; ++i) {
+            const struct ggml_cpu_profile_record * record = &ggml_cpu_profile_records[i];
+            fprintf(file, "%" PRIu64 ",%d,%s,%d,%" PRId64 ",%" PRId64 ",%" PRId64 ",\"%s\",\"%s\",\"%s\"\n",
+                record->graph_id, record->node_index, ggml_op_name((enum ggml_op) record->op), record->fused_nodes,
+                record->worker_us, record->barrier_us, record->graph_elapsed_us, record->name, record->src0, record->src1);
+        }
+        fclose(file);
+    }
+    free(ggml_cpu_profile_records);
+    ggml_cpu_profile_records = NULL;
+    ggml_cpu_profile_count = 0;
+    ggml_cpu_profile_capacity = 0;
+    ggml_cpu_profile_path[0] = '\0';
+}
+
+static struct ggml_cpu_profile_record * ggml_cpu_profile_record_node(
+        uint64_t graph_id, int node_index, const struct ggml_tensor * node,
+        int fused_nodes, int64_t worker_us) {
+    if (ggml_cpu_profile_count >= ggml_cpu_profile_capacity) {
+        return NULL;
+    }
+    struct ggml_cpu_profile_record * record = &ggml_cpu_profile_records[ggml_cpu_profile_count++];
+    record->graph_id = graph_id;
+    record->node_index = node_index;
+    record->op = node->op;
+    record->fused_nodes = fused_nodes;
+    record->worker_us = worker_us;
+    record->barrier_us = 0;
+    record->graph_elapsed_us = 0;
+    record->name = node->name;
+    record->src0 = node->src[0] ? node->src[0]->name : "";
+    record->src1 = node->src[1] ? node->src[1]->name : "";
+    return record;
+}
+
+static bool ggml_cpu_profile_is_marker(const struct ggml_tensor * node) {
+    const char * name = node->name;
+    return name[0] != '\0' && (
+        strncmp(name, "model.input_embed", 17) == 0 ||
+        strncmp(name, "attn_norm-", 10) == 0 ||
+        strncmp(name, "attn_output-", 12) == 0 ||
+        strncmp(name, "linear_attn_out-", 16) == 0 ||
+        strncmp(name, "ffn_moe_inp-", 12) == 0 ||
+        strncmp(name, "ffn_moe_topk-", 13) == 0 ||
+        strncmp(name, "ffn_moe_argsort-", 16) == 0 ||
+        strncmp(name, "ffn_moe_out-", 12) == 0 ||
+        strncmp(name, "ffn_shexp-", 10) == 0 ||
+        strncmp(name, "ffn_shexp_gated-", 16) == 0 ||
+        strncmp(name, "ffn_out-", 8) == 0 ||
+        strncmp(name, "post_moe-", 9) == 0 ||
+        strncmp(name, "result_norm", 11) == 0 ||
+        strncmp(name, "result_output", 13) == 0);
+}
+
 #if defined(__clang__) || defined(__GNUC__)
 #define GGML_CACHE_ALIGN __attribute__((aligned(GGML_CACHE_LINE)))
 #endif
