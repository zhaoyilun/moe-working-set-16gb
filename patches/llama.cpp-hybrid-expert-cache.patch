+            backend, tensor, hybrid_cache_route_ids.data(), 0,
+            hybrid_cache_route_ids.size() * sizeof(hybrid_cache_route_ids[0]));
+    ggml_backend_sched_synchronize(sched.get());
+
+    ++hybrid_cache_clock;
+    ++hybrid_cache_stats.decode_tokens;
+    llama_model & mutable_model = const_cast<llama_model &>(model);
+
