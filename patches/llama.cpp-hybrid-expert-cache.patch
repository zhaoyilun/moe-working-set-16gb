+static std::vector<std::vector<int32_t>> load_hybrid_expert_cache_plan(
+        const char * path, int n_layers, int n_experts) {
+    std::ifstream input(path);
+    if (!input) {
+        throw std::runtime_error(format("failed to open hybrid expert cache plan '%s'", path));
+    }
+
+    std::vector<std::vector<int32_t>> result(n_layers);
+    std::string line;
+    int line_number = 0;
+    while (std::getline(input, line)) {
+        ++line_number;
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        std::replace(line.begin(), line.end(), ',', ' ');
+        std::istringstream row(line);
+        int layer = -1;
+        int expert = -1;
+        if (!(row >> layer >> expert)) {
+            if (line_number == 1) {
+                continue;
+            }
+            throw std::runtime_error(format("invalid hybrid cache plan row %d", line_number));
+        }
+        if (layer < 0 || layer >= n_layers || expert < 0 || expert >= n_experts) {
+            throw std::runtime_error(format("hybrid cache plan row %d is out of range", line_number));
+        }
+        result[layer].push_back(static_cast<int32_t>(expert));
+    }
+
+    size_t total = 0;
+    for (int layer = 0; layer < n_layers; ++layer) {
+        auto & ids = result[layer];
+        std::sort(ids.begin(), ids.end());
+        ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+        if (ids.empty()) {
+            throw std::runtime_error(format("hybrid cache plan has no resident experts for layer %d", layer));
+        }
+        total += ids.size();
+    }
+    LLAMA_LOG_INFO("hybrid expert cache: loaded %zu resident layer-expert entries from %s\n", total, path);
+    return result;
+}
