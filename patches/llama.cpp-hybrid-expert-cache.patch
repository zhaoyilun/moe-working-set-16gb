+void llama_context::hybrid_cache_process_routes(const llm_graph_result * res, uint32_t n_tokens) {
+    if (hybrid_cache_promote_threshold < 0 || n_tokens != 1) {
+        return;
+    }
+
+    const int n_layer = model.hparams.n_layer();
+    const int n_expert_used = model.hparams.n_expert_used;
