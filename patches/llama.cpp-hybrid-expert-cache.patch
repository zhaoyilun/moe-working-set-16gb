+            GGML_ASSERT(expert >= 0 && expert < model.hparams.n_expert);
+            ++hybrid_cache_stats.expert_requests;
+            if (state.cpu_map[expert] < 0) {
+                ++hybrid_cache_stats.cache_hits;
+                const size_t slot = static_cast<size_t>(state.gpu_map[expert]);
+                state.last_touch[slot] = hybrid_cache_clock;
